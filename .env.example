# ── AI backend ────────────────────────────────────────────
# Which coding-agent CLI drives analysis + cover letters.
# One of: claude | codex | opencode  (must be installed & authenticated)
AI_CLI=claude

# ── discovery ─────────────────────────────────────────────
# Comma-separated job feeds to pull from. Leave unset for the default set.
#
# Default (structured, dated, no key):
#   remoteok, remotive, arbeitnow, weworkremotely, himalayas, jobicy, workingnomads,
#   themuse, greenhouse, lever
#   (greenhouse/lever pull public company job boards — edit the company lists at
#    the top of sources.py to target the employers you care about.)
# Opt-in (not in default set):
#   hackernews — freeform "Who is hiring" comments (noisy)
#   linkedin   — the ONLY source of onsite + Bangladesh-local roles, but it is
#                HTML-scraped from the public guest endpoint and can rate-limit
#                or block by IP. Add it explicitly when you want local jobs.
#
# Example — defaults plus LinkedIn for Bangladesh-local onsite roles:
# SOURCES=remoteok,remotive,arbeitnow,weworkremotely,himalayas,jobicy,workingnomads,linkedin

# Drop postings older than this many days (the freshness cutoff).
MAX_JOB_AGE_DAYS=30

# Cap how many of the freshest matching jobs get sent to the AI for scoring
# (keeps token cost bounded).
MAX_JOBS_TO_ANALYZE=100

# Best-effort LinkedIn guest search. Keep low to avoid rate limits.
LINKEDIN_MAX_PAGES=2
SOURCE_CACHE_HOURS=6

# Add public company-board slugs beyond the built-in defaults.
ASHBY_COMPANIES=
